# Salin file ini jadi ".env" (tanpa .example) lalu isi nilainya masing-masing.
# JANGAN commit file ".env" asli ke Git -- isinya rahasia (secret/password).

# --- JWT (WAJIB diisi, boleh string acak apa aja yang panjang) ---
# Dipakai buat nandatangani token login (JWT), bukan cookie session lagi.
SESSION_SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# --- Login Google (WAJIB buat login user biasa) ---
# Bikin dulu OAuth Client ID (tipe "Web application") di
# https://console.cloud.google.com/apis/credentials, lalu di bagian
# "Authorized JavaScript origins" tambahkan URL frontend GitHub Pages kamu.
# CATATAN: GOOGLE_CLIENT_SECRET & GOOGLE_REDIRECT_URI SUDAH TIDAK DIPAKAI --
# frontend pakai Google Identity Services (ID token), backend cuma verifikasi.
GOOGLE_CLIENT_ID=

# --- Login Admin (username/password sederhana, WAJIB diisi) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# --- CORS: domain frontend yang boleh manggil API ini ---
# Development: http://localhost:5500 (atau berapa pun port live-server kamu)
# Produksi: https://username.github.io  (TANPA trailing slash, TANPA path)
FRONTEND_ORIGIN=*

# --- Gemini API (OPSIONAL -- kalau kosong, sistem otomatis pakai penjelasan
#     template offline dari disease_info.py, aplikasi tetap jalan normal) ---
GEMINI_API_KEY=

# --- Hugging Face Hub (sumber file .onnx model, WAJIB diisi di produksi) ---
# Nama repo yang kamu buat di scripts/upload_to_hf.py, contoh: markus/neurocheck-onnx
HF_REPO_ID=namamu/neurocheck-onnx
HF_PRECHECK_FILENAME=precheck_brain_gate.onnx
HF_MAIN_MODEL_FILENAME=hybrid_vit_efficientnet_brain.onnx
# Isi HF_TOKEN kalau repo Hugging Face-nya PRIVATE (biarin kosong kalau public)
HF_TOKEN=

# --- Turso (database produksi). KOSONGKAN untuk pakai SQLite lokal saat dev. ---
# Ambil dari: turso db show --url <nama-db>  &  turso db tokens create <nama-db>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
